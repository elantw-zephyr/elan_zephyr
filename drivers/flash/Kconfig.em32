config FLASH_EM32
	bool "ELAN eM32 flash controller driver"
	default y
	depends on DT_HAS_ELAN_EM32_FLASH_CONTROLLER_ENABLED
	select FLASH_HAS_DRIVER_ENABLED
	select MPU_ALLOW_FLASH_WRITE if ARM_MPU
	help
	  This option enables Elan eM32 flash driver.
